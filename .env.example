# ==============================================================================
# NaaliWatch - Environment Configuration Template
# GDG Buildathon 2026 | Civic Tech & Urban Resilience for Peshawar
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + Drizzle ORM)
# ------------------------------------------------------------------------------
# Connection string to PostgreSQL instance.
# Example local format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Example Neon/Cloud format: postgresql://user:pass@ep-cool-sample.region.neon.tech/naali_watch?sslmode=require
DATABASE_URL=postgresql://postgres:12345@localhost:5433/naali_watch

# ------------------------------------------------------------------------------
# 2. NEXT-AUTH / AUTH.JS CONFIGURATION
# ------------------------------------------------------------------------------
# Random secure string used to sign sessions and JWT tokens.
# Generate one using: openssl rand -base64 32
AUTH_SECRET=your_super_secret_auth_key_here_change_in_production
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# Optional Google OAuth Provider (Self-registration & demo accounts work out-of-the-box)
AUTH_GOOGLE_ID=your_google_client_id_here.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI CONFIGURATION (Multimodal Vision Engine)
# ------------------------------------------------------------------------------
# Get your Gemini API Key from Google AI Studio: https://aistudio.google.com/
# Used for automatic image analysis, hazard classification (ankle/knee/danger),
# landmark/signboard detection, and automated bilingual Urdu/English complaint generation.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. MUNICIPAL DISPATCH & NOTIFICATIONS (WSSP Peshawar Integration)
# ------------------------------------------------------------------------------
# SMTP credentials to send automated dispatch alerts directly to Water and
# Sanitation Services Peshawar (WSSP) complaint cell upon report verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=naaliwatch.peshawar@gmail.com
SMTP_PASS=your_gmail_app_password_here
WSSP_EMAIL=wssp.complaints.peshawar@gmail.com
